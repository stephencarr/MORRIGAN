{
  "name": "morrigan",
  "version": "0.1.0",
  "private": true,
  "description": "A six-voice LXR instrument and configurable hardware-design playground, based on CLATTER.",
  "repository": {
    "type": "git",
    "url": "https://github.com/stephencarr/MORRIGAN.git"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lxr": "node scripts/build-lxr.mjs",
    "check:lxr": "node scripts/build-lxr.mjs --check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval:kits": "vitest run --config vitest.eval.config.ts",
    "eval:report": "node scripts/eval-report.mjs docs/eval/baseline.json docs/eval/after.json > docs/eval/REPORT.md",
    "dev:instrument": "vite --open /morrigan.html"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@slopfactory/core": "github:clickysteve/slopfactory-core#f567d817e12f09b5a2b62985524e40378a670fb5"
  }
}
